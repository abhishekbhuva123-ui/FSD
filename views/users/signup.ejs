<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <h1 class="col-6 offset-3">SignUp on Wondurlast</h1>
        <div class="col-6 offset-3">
            <form action="/signup" method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label ">UserName</label>
                    <input type="text" name="username" required class="form-control required">
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label ">Email</label>
                    <input type="email" name="email" required class="form-control required">
                </div>
                <div class="mb-3">
                    <label for="Password" class="form-label ">Password</label>
                    <input type="password" name="password" required class="form-control required">
                </div>
                <button class="btn btn-success">SignUp</button>
            </form>
        </div>
    </div>