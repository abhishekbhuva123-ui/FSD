<% layout("/layouts/boilerplate") %>

    <body>

        <div class="row">
            <div class="col-8 offset-3 mt-3">
                <h3> <b>
                        <%= listing.title %>
                    </b></h3>
            </div>
            <div class="col-6 offset-3">
                <div class="card listing-card">
                    <img src="<%= listing.image.url  %>" class="card-img-top show-img" alt="...">
                    <div class="card-body">
                        <div class="card-text">
                            Owned By<i>
                                <%= listing.owner.username %>
                            </i><br><br>
                            <%= listing.description %>
                                <br>
                                &#x20B9 <%= listing.price.toLocaleString("en-IN") %>
                                    <br>
                                    <%= listing.location %>
                                        <br>
                                        <%= listing.country %>
                                            <br>
                                            <% if(currentUser && currentUser._id.equals(listing.owner._id)) { %>
                                                <div class="row">
                                                    <div class="col-2"><a class="btn btn-danger"
                                                            href="/listing/<%= listing._id %>/edit">Update</a>
                                                    </div>
                                                    <div class="col-2">
                                                        <form method="post"
                                                            action="/listing/<%= listing._id %>?_method=DELETE">
                                                            <button class="btn btn-danger ms-2">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                                <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 mt-3 offset-3">
                <% if(currentUser){ %>
                    <hr>
                    <h4>Leave a Review</h4>
                    <form action="/listing/<%= listing.id %>/review" method="post" novalidate class="needs-validation">
                        <div>
                            <!-- <label class="form-label" for="rating" class="">Rating</label>
                            <input type="range" class="form-range" min="1" max="5" id="rating" name="review[rating]"> -->

                            <fieldset class="starability-slot">
                                <legend>Rating:</legend>
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div>
                            <label class="form-label" for="comment">Comment</label>
                            <textarea class="form-control" name="review[comment]" id="comment" rows="5" required
                                cols="30"></textarea>
                            <div class="invalid-feedback">Please type some feedback</div>
                        </div>
                        <button class="btn btn-outline-dark mt-3" type="submit">submit</button>
                    </form>
                    <% } %>

                        <hr>
                        <p><b> All Reviews</b></p>
                        <div class="row">
                            <% for(review of listing.review){ %>
                                <div class="card col-5 ms-3 mb-3 " style="width: 300px;">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            <%= review.author.username %>
                                        </h5>
                                        <p class="starability-result" data-rating=<%=review.rating %>>
                                        </p>
                                        <p class="card-text">
                                            <%= review.comment %>
                                        </p>

                                    </div>
                                    <form class="mb-3" method="post"
                                        action="/listing/<%= listing._id %>/review/<%= review._id %>?_method=DELETE">
                                        <button class="btn btn-sm btn-danger ">Delete</button>
                                    </form>
                                </div>
                                <% } %>
                        </div>
            </div>



        </div>
    </body>