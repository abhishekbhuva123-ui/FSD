<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">
            <div class="col-8 offset-2">
                <h3>Create new list</h3>
                <form action="/listing" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
                    <div>
                        <label for="title" class="form-label">Title</label>
                        <input type="text" name="listing[title]" required placeholder="title" class="form-control">
                    </div>
                    <br>
                    <div>
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" required placeholder="description"
                            class="form-control"></textarea>
                    </div>
                    <br>
                    <div>
                        <label for="image" class="form-label">Upload Image</label>
                        <input type="file" name="listing[image]" class="form-control" required>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input required name="listing[price]" placeholder="Enter price" class="form-control">
                        </div>

                        <br>
                        <div class="col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input type="text" required name="listing[country]" placeholder="Enter country"
                                class="form-control">
                        </div>
                    </div>

                    <br>
                    <div>
                        <label for="location" class="form-label">Location</label>
                        <input type="text" required name="listing[location]" placeholder="Enter location"
                            class="form-control">
                    </div>

                    <br>
                    <div>
                        <button type="submit" class="btn btn-danger">Add</button>
                    </div>

                </form>
            </div>
        </div>
    </body>