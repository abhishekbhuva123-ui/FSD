<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row mt-3 mb-3">
            <div class="col-8 offset-2">
                <h3>Update Listing Data</h3>
                <form action="/listing/<%= listing._id %>?_method=PUT" method="post" novalidate class="needs-validation"
                    enctype="multipart/form-data">
                    <div>
                        <label for="title" class="form-label">Title</label>
                        <input type="text" required class="form-control" name="listing[title]" value=<%=listing.title
                            %>>
                    </div>
                    <br>
                    <div>
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" required class="form-control"
                            class="form-control"><%=listing.description %></textarea>
                    </div>
                    <br>

                    <div>
                        <img src="<%= listing.image.url %>" alt="">
                    </div>

                    <div>
                        <label for="image" class="form-label">Image</label>
                        <input type="file" class="form-control" name="listing[image]">
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <label for="price" class="form-label">Price</label>
                            <input type="number" required class="form-control" name="listing[price]"
                                value=<%=listing.price %>>
                        </div>

                        <br>
                        <div class="col-md-8">
                            <label for="country" class="form-label">Country</label>
                            <input required type="text" class="form-control" name="listing[country]"
                                value=<%=listing.country %>>
                        </div>
                    </div>

                    <br>
                    <div>
                        <label for="location" class="form-label">Location</label>
                        <input type="text" required class="form-control" name="listing[location]"
                            value=<%=listing.location %>>
                    </div>

                    <br>
                    <div>
                        <button type="submit" class="btn btn-danger ">Update</button>
                    </div>

                </form>
            </div>
        </div>
    </body>